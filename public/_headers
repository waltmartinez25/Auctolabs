# Cloudflare Pages response headers.
#
# Deliberately no Content-Security-Policy here. The app loads Google Fonts,
# GA4, Simple Icons and Calendly, and embeds Supabase calls — a CSP that misses
# one of those fails silently in production and is worse than none. Add it
# once, deliberately, with the full origin list to hand.

/*
  # Don't let the site be framed — clickjacking protection.
  X-Frame-Options: DENY
  # Trust declared content types instead of letting the browser sniff.
  X-Content-Type-Options: nosniff
  # Send the origin to other sites, the full path only to ourselves.
  Referrer-Policy: strict-origin-when-cross-origin
  # Nothing here needs camera, mic or geolocation.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# Vite fingerprints these filenames, so a changed file is a changed URL and
# they can be cached indefinitely.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML is not fingerprinted. Revalidate every time so a deploy is picked up
# immediately rather than serving a stale shell against fresh assets.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
